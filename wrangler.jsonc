{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-telegram-topic-bot",
  "main": "src/index.js",
  "compatibility_date": "2025-11-01",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOT",
        "class_name": "BotDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BotDO"]
    }
  ]
}
